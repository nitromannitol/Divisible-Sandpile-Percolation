import Sandpile.External.ContinuumRSW.CompactUpper
import Sandpile.Support.CrossFKG
import Mathlib.MeasureTheory.Measure.RegularityCompacts

/-!
# Association of compact upper events

Finite-coordinate positive association passes to upper sets generated by compact
sets through decreasing finite-coordinate approximations.
-/

open Filter MeasureTheory Set Topology

namespace Sandpile.External.ContinuumRSW

variable {ι β : Type} [DecidableEq ι] [Preorder β]
  [TopologicalSpace β] [OrderClosedTopology β]

variable [MeasurableSpace (ι → β)]

/-- Positive association for increasing events determined by finitely many coordinates. -/
def FiniteCoordinateAssociation (μ : Measure (ι → β)) : Prop :=
  ∀ (s : Finset ι) (A B : Set (ι → β)),
    IsUpperSet A → IsUpperSet B → MeasurableSet A → MeasurableSet B →
    (∀ x y, (∀ i ∈ s, x i = y i) → (x ∈ A ↔ y ∈ A)) →
    (∀ x y, (∀ i ∈ s, x i = y i) → (x ∈ B ↔ y ∈ B)) →
    μ.real A * μ.real B ≤ μ.real (A ∩ B)

omit [MeasurableSpace (ι → β)] in
/-- The upper closure is the intersection along an exhausting coordinate sequence. -/
theorem upperClosure_eq_iInter_finiteUpperApprox {S : Set (ι → β)} (hS : IsCompact S)
    (e : ℕ → ι) (he : Function.Surjective e) :
    (upperClosure S : Set (ι → β)) =
      ⋂ n, finiteUpperApprox S ((Finset.range n).image e) := by
  classical
  ext x
  rw [mem_iInter]
  change (x ∈ upperClosure S) ↔ _
  rw [mem_upperClosure_iff_forall_finiteUpperApprox hS]
  constructor
  · intro h n
    exact h _
  · intro h s
    choose k hk using fun i => he i
    let n := s.sup (fun i => k i + 1)
    have hn : s ⊆ (Finset.range n).image e := by
      intro i hi
      apply Finset.mem_image.mpr
      refine ⟨k i, Finset.mem_range.mpr ?_, hk i⟩
      exact lt_of_lt_of_le (Nat.lt_succ_self _) (Finset.le_sup (f := fun i => k i + 1) hi)
    exact finiteUpperApprox_antitone S hn (h n)

variable [Countable ι] [Nonempty ι] [CompactSpace β] [T2Space β]
  [OpensMeasurableSpace (ι → β)]

/-- The upper closures of two compact sets inherit finite-coordinate association. -/
theorem measureReal_upperClosure_mul_le {μ : Measure (ι → β)} [IsProbabilityMeasure μ]
    (hassoc : FiniteCoordinateAssociation μ) {K L : Set (ι → β)}
    (hK : IsCompact K) (hL : IsCompact L) :
    μ.real (upperClosure K) * μ.real (upperClosure L) ≤
      μ.real ((upperClosure K : Set (ι → β)) ∩ upperClosure L) := by
  classical
  obtain ⟨e, he⟩ := exists_surjective_nat ι
  let F : ℕ → Finset ι := fun n => (Finset.range n).image e
  let A : ℕ → Set (ι → β) := fun n => finiteUpperApprox K (F n)
  let B : ℕ → Set (ι → β) := fun n => finiteUpperApprox L (F n)
  have hF : Monotone F := by
    intro n m hnm
    exact Finset.image_subset_image (Finset.range_mono hnm)
  have hA : Antitone A := fun n m hnm => finiteUpperApprox_antitone K (hF hnm)
  have hB : Antitone B := fun n m hnm => finiteUpperApprox_antitone L (hF hnm)
  have hmA : ∀ n, MeasurableSet (A n) := fun n =>
    (isCompact_finiteUpperApprox K hK (F n)).isClosed.measurableSet
  have hmB : ∀ n, MeasurableSet (B n) := fun n =>
    (isCompact_finiteUpperApprox L hL (F n)).isClosed.measurableSet
  have hbound : ∀ n, μ.real (A n) * μ.real (B n) ≤ μ.real (A n ∩ B n) := by
    intro n
    exact hassoc (F n) (A n) (B n) (isUpperSet_finiteUpperApprox _ _)
      (isUpperSet_finiteUpperApprox _ _) (hmA n) (hmB n)
      (fun _ _ h => mem_finiteUpperApprox_congr _ _ h)
      (fun _ _ h => mem_finiteUpperApprox_congr _ _ h)
  have hlim : μ.real (⋂ n, A n) * μ.real (⋂ n, B n) ≤
      μ.real (⋂ n, A n ∩ B n) := le_of_tendsto_of_tendsto'
    ((Sandpile.Support.tendsto_measureReal_iInter (P := μ) A hmA hA).mul
      (Sandpile.Support.tendsto_measureReal_iInter (P := μ) B hmB hB))
    (Sandpile.Support.tendsto_measureReal_iInter (P := μ) (fun n => A n ∩ B n)
      (fun n => (hmA n).inter (hmB n))
      (fun n m hnm => inter_subset_inter (hA hnm) (hB hnm))) hbound
  have hAB : (⋂ n, A n ∩ B n) = (⋂ n, A n) ∩ (⋂ n, B n) := by
    ext x
    simp only [mem_iInter, mem_inter_iff]
    exact forall_and
  have hKA : (upperClosure K : Set (ι → β)) = ⋂ n, A n :=
    upperClosure_eq_iInter_finiteUpperApprox hK e he
  have hLB : (upperClosure L : Set (ι → β)) = ⋂ n, B n :=
    upperClosure_eq_iInter_finiteUpperApprox hL e he
  calc
    μ.real (upperClosure K) * μ.real (upperClosure L) =
        μ.real (⋂ n, A n) * μ.real (⋂ n, B n) :=
      congrArg₂ (· * ·) (congrArg μ.real hKA) (congrArg μ.real hLB)
    _ ≤ μ.real (⋂ n, A n ∩ B n) := hlim
    _ = μ.real ((upperClosure K : Set (ι → β)) ∩ upperClosure L) :=
      congrArg μ.real (hAB.trans (congrArg₂ (· ∩ ·) hKA.symm hLB.symm))

end Sandpile.External.ContinuumRSW
