import Sandpile.External.Stopping.StoppedPathSigma

/-!
# The future-increment path

The future increments of a continuous path form a continuous path, and their
sigma-algebra is generated by this path. The operation is continuous for
uniform convergence on compact time intervals.
-/

open MeasureTheory Topology
open scoped NNReal ENNReal

namespace Sandpile.External.Stopping

/-- The path of increments after a fixed time. -/
noncomputable def futureIncrementPath {d : ℕ} (t : ℝ≥0)
    (f : C(ℝ≥0, Continuum.Space d)) : C(ℝ≥0, Continuum.Space d) where
  toFun s := f (t + s) - f t
  continuous_toFun := (f.continuous.comp (continuous_const.add continuous_id)).sub
    continuous_const

@[simp] theorem futureIncrementPath_apply {d : ℕ} (t : ℝ≥0)
    (f : C(ℝ≥0, Continuum.Space d)) (s : ℝ≥0) :
    futureIncrementPath t f s = f (t + s) - f t := rfl

/-- Taking increments after a fixed time is continuous on path space. -/
theorem continuous_futureIncrementPath {d : ℕ} (t : ℝ≥0) :
    Continuous (futureIncrementPath (d := d) t) := by
  apply ContinuousMap.continuous_of_continuous_uncurry
  exact (continuous_eval.comp (continuous_fst.prodMk
    (continuous_const.add continuous_snd))).sub
      (continuous_eval.comp (continuous_fst.prodMk continuous_const))

/-- The future-increment path depends continuously on both the starting time
and the original path. -/
theorem continuous_futureIncrementPath_uncurry {d : ℕ} :
    Continuous (fun p : ℝ≥0 × C(ℝ≥0, Continuum.Space d) =>
      futureIncrementPath p.1 p.2) := by
  apply ContinuousMap.continuous_of_continuous_uncurry
  exact (continuous_eval.comp ((continuous_snd.comp continuous_fst).prodMk
    ((continuous_fst.comp continuous_fst).add continuous_snd))).sub
      (continuous_eval.comp ((continuous_snd.comp continuous_fst).prodMk
        (continuous_fst.comp continuous_fst)))

/-- The future-increment path generates the future-increment sigma-algebra. -/
theorem comap_futureIncrementPath_eq_pathFutureSigma {d : ℕ} (t : ℝ≥0) :
    MeasurableSpace.comap (futureIncrementPath (d := d) t) inferInstance =
      pathFutureSigma t := by
  rw [ContinuousMap.measurableSpace_eq_iSup_comap_eval, MeasurableSpace.comap_iSup]
  simp only [MeasurableSpace.comap_comp, Function.comp_def, futureIncrementPath_apply,
    pathFutureSigma]

end Sandpile.External.Stopping
