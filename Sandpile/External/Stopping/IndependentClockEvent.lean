import Sandpile.External.Stopping.WalkClockWeakIndependence
import Sandpile.External.Stopping.PathClockCausality

/-!
# Future independence and stopping events

Independence of the future from each stopped path and clipped clock implies
independence from the past together with a clock sublevel event. A small time
gap retains the boundary of that event before the gap is closed.
-/

open MeasureTheory ProbabilityTheory Filter Topology Set
open scoped NNReal ENNReal

namespace Sandpile.External.Stopping

/-- Future independence from stopped paths and clipped clocks also implies
independence from the past and any clock event at an earlier threshold. -/
theorem indepFun_future_past_clockEvent {d : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (W : Ω → C(ℝ≥0, Continuum.Space d)) (τ : Ω → ℝ≥0)
    (hW : Measurable W) (hτ : Measurable τ)
    (hind : ∀ u : ℝ≥0, IndepFun (fun ω => futureIncrementPath u (W ω))
      (fun ω => (LatticeProb.stoppedPath (u : ℝ≥0∞) (W ω), min (τ ω) u)) P)
    (t a : ℝ≥0) (ha : a ≤ t) :
    IndepFun (fun ω => futureIncrementPath t (W ω))
      (fun ω => (LatticeProb.stoppedPath (t : ℝ≥0∞) (W ω),
        (Set.Iic a).indicator (fun _ : ℝ≥0 => (1 : ℝ)) (τ ω))) P := by
  let E := C(ℝ≥0, Continuum.Space d) × ℝ
  let : MetricSpace E := TopologicalSpace.metrizableSpaceMetric _
  let Y : Ω → E := fun ω => (LatticeProb.stoppedPath (t : ℝ≥0∞) (W ω),
    (Set.Iic a).indicator (fun _ : ℝ≥0 => (1 : ℝ)) (τ ω))
  have hY : Measurable Y :=
    (LatticeProb.continuous_stoppedPath.measurable.comp
      (measurable_const.prodMk hW)).prodMk
      ((measurable_const.indicator measurableSet_Iic).comp hτ)
  let u : ℕ → ℝ≥0 := fun n => t + 1 / (n + 1)
  have hu : Tendsto u atTop (𝓝 t) := by
    dsimp [u]
    simpa using tendsto_const_nhds.add
      (tendsto_one_div_add_atTop_nhds_zero_nat : Tendsto (fun n : ℕ => (1 : ℝ≥0) / (n + 1)) atTop (𝓝 0))
  apply indepFun_futureIncrementPath_of_tendsto P W Y hW hY u t hu
  intro n
  have htu : t < u n := by dsimp [u]; exact lt_add_of_pos_right _ (by positivity)
  let φ : C(ℝ≥0, Continuum.Space d) × ℝ≥0 → E := fun p =>
    (LatticeProb.stoppedPath (t : ℝ≥0∞) p.1,
      (Set.Iic a).indicator (fun _ : ℝ≥0 => (1 : ℝ)) p.2)
  have hφ : Measurable φ :=
    (LatticeProb.continuous_stoppedPath.measurable.comp
      (measurable_const.prodMk measurable_fst)).prodMk
      ((measurable_const.indicator measurableSet_Iic).comp measurable_snd)
  have hi := (hind (u n)).comp measurable_id hφ
  convert hi using 1
  · rfl
  · funext ω
    simp only [Function.comp_apply, φ, Y]
    apply Prod.ext
    · apply ContinuousMap.ext
      intro s
      simp only [LatticeProb.stoppedPath_apply, ← ENNReal.coe_min, ENNReal.toNNReal_coe]
      rw [min_assoc, min_eq_left htu.le]
    · have he : min (τ ω) (u n) ∈ Set.Iic a ↔ τ ω ∈ Set.Iic a := by
        simp only [Set.mem_Iic, min_le_iff]
        exact or_iff_left (not_le_of_gt (ha.trans_lt htu))
      by_cases hmem : τ ω ∈ Set.Iic a
      · simp only [Set.indicator_of_mem hmem, Set.indicator_of_mem (he.2 hmem)]
      · simp only [Set.indicator_of_notMem hmem, Set.indicator_of_notMem (mt he.1 hmem)]

/-- Future increments are independent of the sigma-algebra generated by the
past and a clock sublevel event. -/
theorem indep_future_pathPast_clockEvent {d : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (W : Ω → C(ℝ≥0, Continuum.Space d)) (τ : Ω → ℝ≥0)
    (hW : Measurable W) (hτ : Measurable τ)
    (hind : ∀ u : ℝ≥0, IndepFun (fun ω => futureIncrementPath u (W ω))
      (fun ω => (LatticeProb.stoppedPath (u : ℝ≥0∞) (W ω), min (τ ω) u)) P)
    (t a : ℝ≥0) (ha : a ≤ t) :
    Indep ((pathFutureSigma (d := d) t).comap W)
      (((pathPastSigma (d := d) t).comap W) ⊔
        MeasurableSpace.generateFrom {{ω | τ ω ≤ a}}) P := by
  have hi := indepFun_future_past_clockEvent P W τ hW hτ hind t a ha
  rw [IndepFun_iff_Indep] at hi
  change Indep _ (MeasurableSpace.comap
    (fun ω => (LatticeProb.stoppedPath (t : ℝ≥0∞) (W ω),
      (Set.Iic a).indicator (fun _ : ℝ≥0 => (1 : ℝ)) (τ ω)))
    ((inferInstance : MeasurableSpace C(ℝ≥0, Continuum.Space d)).prod
      (inferInstance : MeasurableSpace ℝ))) P at hi
  rw [MeasurableSpace.comap_prodMk] at hi
  have hfuture : ((pathFutureSigma (d := d) t).comap W) =
      MeasurableSpace.comap (fun ω => futureIncrementPath t (W ω)) inferInstance := by
    rw [← comap_futureIncrementPath_eq_pathFutureSigma, MeasurableSpace.comap_comp]
    rfl
  have hpast : ((pathPastSigma (d := d) t).comap W) =
      MeasurableSpace.comap (fun ω => LatticeProb.stoppedPath (t : ℝ≥0∞) (W ω))
        inferInstance := by
    rw [← comap_stoppedPath_eq_pathPastSigma, MeasurableSpace.comap_comp]
    rfl
  have hclock : MeasurableSpace.generateFrom {{ω | τ ω ≤ a}} ≤
      MeasurableSpace.comap
        (fun ω => (Set.Iic a).indicator (fun _ : ℝ≥0 => (1 : ℝ)) (τ ω)) inferInstance := by
    apply MeasurableSpace.generateFrom_le
    intro s hs
    simp only [Set.mem_singleton_iff] at hs
    subst s
    apply MeasurableSpace.measurableSet_comap.2
    refine ⟨{1}, measurableSet_singleton _, ?_⟩
    ext ω
    by_cases hω : τ ω ≤ a
    · simp [hω]
    · simp [hω]
  rw [hfuture, hpast]
  apply (Indep_iff _ _ _).2
  intro s v hs hv
  exact (Indep_iff _ _ _).1 hi s v hs ((sup_le_sup le_rfl hclock) _ hv)

end Sandpile.External.Stopping
