import Sandpile.External.Stopping.KernelCDFConditionalExpectation
import Sandpile.External.Stopping.PathPastFuture

/-!
# Causal clock laws on continuous path space

Independence of future increments from past observations and a clock event
makes its conditional probability adapted to the path's natural filtration.
This is the causality criterion used in Coquet and Toldo, Section 2.3.1.
-/

open MeasureTheory ProbabilityTheory Set Filter unitInterval
open scoped NNReal ENNReal ProbabilityTheory

namespace Sandpile.External.Stopping

/-- The natural coordinate filtration on continuous-path space. -/
noncomputable def pathFiltration {d : ℕ} :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace C(ℝ≥0, Continuum.Space d)) :=
  Filtration.natural (fun s (f : C(ℝ≥0, Continuum.Space d)) => f s)
    (fun s => (ContinuousMap.measurable_eval s).stronglyMeasurable)

/-- The coordinate filtration is generated by past path observations. -/
theorem pathFiltration_eq_pathPastSigma {d : ℕ} (t : ℝ≥0) :
    (pathFiltration (d := d)) t = pathPastSigma t := by
  rw [pathPastSigma_eq_brownianFiltration]
  rfl

/-- If the future increments are independent of the past and a clock event,
the event's conditional path probability has an adapted version. -/
theorem exists_path_kernel_event_version_of_independent_future {d : ℕ}
    (ρ : Measure (C(ℝ≥0, Continuum.Space d) × I)) [IsProbabilityMeasure ρ]
    (t : ℝ≥0) (s : Set I) (hs : MeasurableSet s)
    (hindep : Indep ((pathFutureSigma (d := d) t).comap Prod.fst)
      (((pathPastSigma (d := d) t).comap Prod.fst) ⊔
        MeasurableSpace.generateFrom {Prod.snd ⁻¹' s}) ρ) :
    ∃ f : C(ℝ≥0, Continuum.Space d) → ℝ,
      @Measurable C(ℝ≥0, Continuum.Space d) ℝ ((pathFiltration (d := d)) t)
        inferInstance f ∧ f =ᵐ[ρ.fst] fun ω => (ρ.condKernel ω).real s := by
  apply exists_kernel_event_version_of_independent_future ρ pathFiltration t s hs
    ((pathFutureSigma t).comap Prod.fst)
  · have hfuture : pathFutureSigma (d := d) t ≤
        (inferInstance : MeasurableSpace C(ℝ≥0, Continuum.Space d)) := by
      rw [← pathPastSigma_sup_pathFutureSigma t]
      exact le_sup_right
    exact (MeasurableSpace.comap_mono hfuture).trans measurable_fst.comap_le
  · rw [pathFiltration_eq_pathPastSigma, ← MeasurableSpace.comap_sup,
      sup_comm, pathPastSigma_sup_pathFutureSigma]
  · simpa only [pathFiltration_eq_pathPastSigma] using hindep

/-- A path-clock law satisfying the independent-future criterion at dense
clock times has an equal-law randomized stopping realization. -/
theorem exists_path_stopping_version_of_independent_future {d : ℕ} {ι : Type*} [Countable ι]
    (ρ : Measure (C(ℝ≥0, Continuum.Space d) × I)) [IsProbabilityMeasure ρ]
    (time : ι → ℝ≥0)
    (hdense : ∀ a b : ℝ≥0, a < b → ∃ i, a < time i ∧ time i < b)
    (hindep : ∀ i, Indep ((pathFutureSigma (d := d) (time i)).comap Prod.fst)
      (((pathPastSigma (d := d) (time i)).comap Prod.fst) ⊔
        MeasurableSpace.generateFrom {Prod.snd ⁻¹' Icc 0 (unitTime (time i))}) ρ) :
    ∃ τ : C(ℝ≥0, Continuum.Space d) × I → ℝ≥0,
      IsStoppingTime (parameterFiltration (pathFiltration (d := d))).rightCont
        (fun p => (τ p : ℝ≥0∞)) ∧
      (∀ p, τ p ≤ 1) ∧
      (ρ.fst.prod volume).map (fun p => (p.1, τ p)) =
        ρ.map (fun p => (p.1, unitClock id p.2)) := by
  apply exists_stopping_version_of_joint_law pathFiltration ρ time hdense
  intro i
  exact exists_path_kernel_event_version_of_independent_future ρ (time i)
    (Icc 0 (unitTime (time i))) measurableSet_Icc (hindep i)

end Sandpile.External.Stopping
