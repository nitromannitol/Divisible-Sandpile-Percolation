import Sandpile.Continuum.Stopping
import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap

/-!
# Past and future increments of continuous paths

The Borel sigma-algebra of continuous paths is generated by the path up to a
fixed time and the increments after that time. This decomposition is used in
the filtration-convergence argument of Coquet and Toldo, Section 2.3.1.
-/

open MeasureTheory
open scoped NNReal

namespace Sandpile.External.Stopping

/-- The sigma-algebra of continuous-path observations up to time `t`. -/
@[instance_reducible] def pathPastSigma {d : ℕ} (t : ℝ≥0) : MeasurableSpace C(ℝ≥0, Continuum.Space d) :=
  ⨆ s : ℝ≥0, ⨆ (_ : s ≤ t), MeasurableSpace.comap (fun f : C(ℝ≥0, Continuum.Space d) => f s)
    inferInstance

/-- The sigma-algebra of continuous-path increments after time `t`. -/
@[instance_reducible] def pathFutureSigma {d : ℕ} (t : ℝ≥0) : MeasurableSpace C(ℝ≥0, Continuum.Space d) :=
  ⨆ s : ℝ≥0, MeasurableSpace.comap (fun f : C(ℝ≥0, Continuum.Space d) => f (t + s) - f t)
    inferInstance

/-- The past path sigma-algebra is the natural filtration of coordinate
evaluation. -/
theorem pathPastSigma_eq_brownianFiltration {d : ℕ} (t : ℝ≥0) :
    pathPastSigma (d := d) t =
      Continuum.brownianFiltration (fun s (f : C(ℝ≥0, Continuum.Space d)) => f s) t := by
  apply le_antisymm
  · unfold pathPastSigma
    apply iSup_le
    intro s
    apply iSup_le
    intro hs
    exact (Continuum.measurable_brownianFiltration
      (fun s (f : C(ℝ≥0, Continuum.Space d)) => f s) s t hs).comap_le
  · apply Continuum.brownianFiltration_le
    intro s hs
    apply measurable_iff_comap_le.mpr
    unfold pathPastSigma
    exact le_iSup_of_le s (le_iSup (fun _ : s ≤ t =>
      MeasurableSpace.comap (fun f : C(ℝ≥0, Continuum.Space d) => f s) inferInstance) hs)

/-- Past observations and future increments together generate the Borel
sigma-algebra of continuous paths. -/
theorem pathPastSigma_sup_pathFutureSigma {d : ℕ} (t : ℝ≥0) :
    pathPastSigma (d := d) t ⊔ pathFutureSigma (d := d) t =
      (inferInstance : MeasurableSpace C(ℝ≥0, Continuum.Space d)) := by
  have hpast (s : ℝ≥0) (hs : s ≤ t) :
      MeasurableSpace.comap (fun f : C(ℝ≥0, Continuum.Space d) => f s) inferInstance ≤
        pathPastSigma t := by
    unfold pathPastSigma
    exact le_iSup_of_le s (le_iSup (fun _ : s ≤ t =>
      MeasurableSpace.comap (fun f : C(ℝ≥0, Continuum.Space d) => f s) inferInstance) hs)
  have hfuture (s : ℝ≥0) :
      MeasurableSpace.comap (fun f : C(ℝ≥0, Continuum.Space d) => f (t + s) - f t)
        inferInstance ≤ pathFutureSigma t := by
    unfold pathFutureSigma
    exact le_iSup (fun s : ℝ≥0 => MeasurableSpace.comap
      (fun f : C(ℝ≥0, Continuum.Space d) => f (t + s) - f t) inferInstance) s
  apply le_antisymm
  · apply sup_le
    · apply iSup_le
      intro s
      apply iSup_le
      intro hs
      exact (ContinuousMap.measurable_eval s).comap_le
    · apply iSup_le
      intro s
      exact ((ContinuousMap.measurable_eval (t + s)).sub
        (ContinuousMap.measurable_eval t)).comap_le
  · rw [ContinuousMap.measurableSpace_eq_iSup_comap_eval]
    apply iSup_le
    intro s
    apply measurable_iff_comap_le.mp
    by_cases hs : s ≤ t
    · exact (comap_measurable (fun f : C(ℝ≥0, Continuum.Space d) => f s)).mono
        ((hpast s hs).trans le_sup_left) le_rfl
    · have ht : t ≤ s := le_of_not_ge hs
      have hbefore : @Measurable C(ℝ≥0, Continuum.Space d) (Continuum.Space d)
          (pathPastSigma t ⊔ pathFutureSigma t) inferInstance (fun f => f t) :=
        (comap_measurable (fun f : C(ℝ≥0, Continuum.Space d) => f t)).mono
          ((hpast t le_rfl).trans le_sup_left) le_rfl
      have hafter : @Measurable C(ℝ≥0, Continuum.Space d) (Continuum.Space d)
          (pathPastSigma t ⊔ pathFutureSigma t) inferInstance
          (fun f => f (t + (s - t)) - f t) :=
        (comap_measurable (fun f : C(ℝ≥0, Continuum.Space d) => f (t + (s - t)) - f t)).mono
          ((hfuture (s - t)).trans le_sup_right) le_rfl
      have hsum := hbefore.add hafter
      convert hsum using 1
      funext f
      simp only [add_tsub_cancel_of_le ht, Pi.add_apply]
      exact ((add_comm (f t) (f s - f t)).trans (sub_add_cancel (f s) (f t))).symm

end Sandpile.External.Stopping
