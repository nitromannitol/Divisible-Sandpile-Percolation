import Sandpile.Continuum.Stopping

/-!
# Countable observations of continuous histories

The natural filtration of a continuous process at a fixed time is generated by
its observations at clipped nonnegative rational times. This presents every
past event as a Borel event of a countable product observation.
-/

open MeasureTheory Filter Topology
open scoped NNReal ENNReal

namespace Sandpile.External.Stopping

/-- Rational observations of a path up to a fixed time. -/
def rationalHistory {Ω : Type*} {d : ℕ}
    (B : ℝ≥0 → Ω → Continuum.Space d) (t : ℝ≥0) (ω : Ω) : ℚ → Continuum.Space d :=
  fun q => B (min (Real.toNNReal (q : ℝ)) t) ω

/-- Every nonnegative time is the limit of clipped rational observation times. -/
theorem exists_rationalHistory_times_tendsto (s t : ℝ≥0) (hs : s ≤ t) :
    ∃ q : ℕ → ℚ, Tendsto (fun n => min (Real.toNNReal (q n : ℝ)) t) atTop (𝓝 s) := by
  obtain ⟨q, _, _, hq⟩ := Rat.denseRange_cast.exists_seq_strictMono_tendsto
    Rat.cast_strictMono.monotone (s : ℝ)
  refine ⟨q, ?_⟩
  have hh := ((continuous_real_toNNReal.tendsto (s : ℝ)).comp hq).min
    (tendsto_const_nhds (x := t))
  simpa only [Function.comp_def, Real.toNNReal_coe, min_eq_left hs] using hh

/-- For continuous paths the natural filtration is generated by the countable
rational history. -/
theorem brownianFiltration_eq_comap_rationalHistory {Ω : Type*} {d : ℕ}
    (B : ℝ≥0 → Ω → Continuum.Space d) (hc : ∀ ω, Continuous fun s => B s ω)
    (t : ℝ≥0) :
    Continuum.brownianFiltration B t = MeasurableSpace.comap (rationalHistory B t) inferInstance := by
  apply le_antisymm
  · apply Continuum.brownianFiltration_le B t
    intro s hs
    obtain ⟨q, hq⟩ := exists_rationalHistory_times_tendsto s t hs
    letI : MeasurableSpace Ω := MeasurableSpace.comap (rationalHistory B t) inferInstance
    have hm (n : ℕ) : Measurable (fun ω => B (min (Real.toNNReal (q n : ℝ)) t) ω) := by
      exact (measurable_pi_apply (q n)).comp (comap_measurable (rationalHistory B t))
    apply measurable_of_tendsto_metrizable hm
    exact tendsto_pi_nhds.2 fun ω => (hc ω).tendsto s |>.comp hq
  · letI : MeasurableSpace Ω := Continuum.brownianFiltration B t
    apply measurable_iff_comap_le.mp
    apply measurable_pi_iff.2
    intro q
    exact Continuum.measurable_brownianFiltration B _ t (min_le_right _ _)

/-- Any natural-filtration event of a continuous process is the pullback of a
Borel event in its rational history. -/
theorem exists_rationalHistory_event {Ω : Type*} {d : ℕ}
    (B : ℝ≥0 → Ω → Continuum.Space d) (hc : ∀ ω, Continuous fun s => B s ω)
    (t : ℝ≥0) (A : Set Ω) (hA : MeasurableSet[Continuum.brownianFiltration B t] A) :
    ∃ S : Set (ℚ → Continuum.Space d), MeasurableSet S ∧ rationalHistory B t ⁻¹' S = A := by
  rw [brownianFiltration_eq_comap_rationalHistory B hc t] at hA
  exact hA

end Sandpile.External.Stopping
